{
  "authors": [
    {
      "name": "UNB Libraries libsupport@unb.ca",
      "role": "Creator"
    }
  ],
  "autoload": {
    "classmap": [
      "scripts/composer/ScriptHandler.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "cweagans/composer-patches": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "drupal/core-composer-scaffold": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true,
      "symfony/runtime": true,
      "tbachert/spi": true
    },
    "discard-changes": true,
    "platform": {
      "php": "8.4.27"
    },
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "policy": {
      "advisories": {
        "block": false
      }
    }
  },
  "conflict": {
    "drupal/drupal": "*"
  },
  "description": "Drupal 11 component of newspapers.lib.unb.ca",
  "extra": {
    "drupal-scaffold": {
      "locations": {
        "web-root": "./"
      }
    },
    "enable-patching": true,
    "installer-paths": {
      "core": [
        "type:drupal-core"
      ],
      "drush/contrib/{$name}": [
        "type:drupal-drush"
      ],
      "libraries/{$name}": [
        "type:drupal-library"
      ],
      "modules/contrib/{$name}": [
        "type:drupal-module"
      ],
      "profiles/contrib/{$name}": [
        "type:drupal-profile"
      ],
      "themes/contrib/{$name}": [
        "type:drupal-theme"
      ]
    },
    "patches": {
      "drupal/address": {
        "Integrate Address with Search API": "https://www.drupal.org/files/issues/2022-08-11/address-n2812659-37-fix.patch",
        "PHP 8.4 explicit nullable types for Search API patch": "https://raw.githubusercontent.com/unb-libraries/newspapers.lib.unb.ca/dev/build/patches/address_search_api_php84.patch"
      },
      "drupal/core": {
        "Exposed filter values available as tokens": "https://www.drupal.org/files/issues/2022-10-30/2761273-50.patch",
        "Extend Daterange functionality": "https://www.drupal.org/files/issues/2024-06-26/2794481-262.patch",
        "To correct DerivativeDiscoveryDecorator warning": "https://www.drupal.org/files/issues/patch_empty_fix.patch"
      },
      "drupal/file_management": {
        "Drupal 11 compatibility": "https://raw.githubusercontent.com/unb-libraries/newspapers.lib.unb.ca/dev/build/patches/file_management_2.x_d11.patch"
      },
      "drupal/jquery_scrollup": {
        "D11 compatibility": "https://www.drupal.org/files/issues/2024-03-17/jquery_scrollup.2.0.0.rector.patch",
        "PHP 8.2 string interpolation deprecations": "https://raw.githubusercontent.com/unb-libraries/newspapers.lib.unb.ca/dev/build/patches/jquery_scrollup_2.0.x_php82.patch"
      }
    }
  },
  "license": "MIT",
  "minimum-stability": "dev",
  "name": "unb-libraries/newspapers.lib.unb.ca",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "drupal/file_management",
        "version": "2.1.0",
        "type": "drupal-module",
        "description": "Allows you to edit existing files or images.",
        "license": "GPL-2.0-or-later",
        "require": {
          "drupal/core": "^10 || ^11"
        },
        "dist": {
          "type": "zip",
          "url": "https://ftp.drupal.org/files/projects/file_management-8.x-2.1.zip",
          "reference": "8.x-2.1",
          "shasum": "6b7414c66ca772f9188941369a89a2e72477ae98"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "drupal/jquery_scrollup",
        "version": "2.0.0",
        "type": "drupal-module",
        "description": "Integrates jquery ScrollUp plugin with Drupal",
        "license": "GPL-2.0-or-later",
        "require": {
          "drupal/core": "^10 || ^11"
        },
        "dist": {
          "type": "zip",
          "url": "https://ftp.drupal.org/files/projects/jquery_scrollup-2.0.0.zip",
          "reference": "2.0.0",
          "shasum": "33a5d649135dd59ed325e9a1eac7b0d557e975c3"
        }
      }
    },
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    },
    {
      "package": {
        "name": "fontawesome/fontawesome",
        "version": "6.7.2",
        "type": "drupal-library",
        "extra": {
          "installer-name": "fontawesome"
        },
        "dist": {
          "url": "https://use.fontawesome.com/releases/v6.7.2/fontawesome-free-6.7.2-web.zip",
          "type": "zip"
        }
      },
      "type": "package"
    },
    {
      "package": {
        "dist": {
          "type": "zip",
          "url": "https://github.com/furf/jquery-ui-touch-punch/archive/refs/heads/master.zip"
        },
        "name": "furf/jquery-ui-touch-punch",
        "type": "drupal-library",
        "version": "dev-master"
      },
      "type": "package"
    },
    {
      "package": {
        "dist": {
          "type": "zip",
          "url": "https://github.com/TurbojetTechnologies/colorbox/archive/master.zip"
        },
        "extra": {
          "installer-name": "colorbox"
        },
        "name": "turbojettechnologies/colorbox",
        "type": "drupal-library",
        "version": "dev-master"
      },
      "type": "package"
    },
    {
      "package": {
        "dist": {
          "type": "zip",
          "url": "https://github.com/noli42/chosen/releases/download/3.1.4/chosen-assets-v3.1.4.zip"
        },
        "name": "noli42/chosen",
        "type": "drupal-library",
        "version": "3.1.4"
      },
      "type": "package"
    },
    {
      "package": {
        "dist": {
          "type": "zip",
          "url": "https://github.com/markgoodyear/scrollup/archive/refs/heads/master.zip"
        },
        "extra": {
          "installer-name": "scrollup"
        },
        "name": "markgoodyear/scrollup",
        "type": "drupal-library",
        "version": "dev-master"
      },
      "type": "package"
    },
    {
      "package": {
        "dist": {
          "type": "zip",
          "url": "https://github.com/OwlCarousel2/OwlCarousel2/archive/2.3.4.zip"
        },
        "name": "owlcarousel2/owlcarousel2",
        "type": "drupal-library",
        "version": "2.3.4"
      },
      "type": "package"
    },
    {
      "package": {
        "dist": {
          "type": "zip",
          "url": "https://github.com/simeydotme/jQuery-ui-Slider-Pips/archive/refs/tags/2.0.0.zip"
        },
        "name": "simeydotme/jquery-ui-slider-pips",
        "type": "drupal-library",
        "version": "2.0.0"
      },
      "type": "package"
    },
    {
      "package": {
        "dist": {
          "type": "zip",
          "url": "https://github.com/zenorocha/clipboard.js/archive/refs/heads/master.zip"
        },
        "extra": {
          "installer-name": "clipboard.js"
        },
        "name": "zenorocha/clipboardjs",
        "type": "drupal-library",
        "version": "dev-master"
      },
      "type": "package"
    }
  ],
  "require": {
    "drupal/address": "^2",
    "drupal/admin_toolbar": "^3",
    "drupal/ajax_loader": "^2",
    "drupal/allowed_formats": "^3",
    "drupal/antibot": "^2",
    "drupal/bootstrap_barrio": "5.1.12",
    "drupal/chosen": "^5",
    "drupal/clipboardjs": "^2",
    "drupal/colorbox": "^2",
    "drupal/conditional_fields": "^4@alpha",
    "drupal/core": "^11",
    "drupal/core-composer-scaffold": "^11",
    "drupal/core-recommended": "^11",
    "drupal/csv_serialization": "^4",
    "drupal/editor_file": "^2",
    "drupal/externalauth": "^2",
    "drupal/facets": "^3",
    "drupal/field_group": "^4@beta",
    "drupal/file_management": "2.1.0",
    "drupal/fontawesome": "^3",
    "drupal/geocoder": "^4",
    "drupal/geofield": "^10",
    "drupal/google_analytics": "^4",
    "drupal/health_check": "^3",
    "drupal/honeypot": "^2",
    "drupal/jquery_scrollup": "2.0.0",
    "drupal/jquery_ui": "^1",
    "drupal/jquery_ui_datepicker": "^2",
    "drupal/jquery_ui_slider": "^2",
    "drupal/jquery_ui_touch_punch": "^1",
    "drupal/languagefield": "^1",
    "drupal/leaflet": "^10",
    "drupal/metatag": "^2",
    "drupal/migrate_plus": "^6",
    "drupal/migrate_source_csv": "^3",
    "drupal/migrate_tools": "^6",
    "drupal/noreqnewpass": "^1",
    "drupal/override_node_options": "^2",
    "drupal/owlcarousel": "^3",
    "drupal/pathauto": "^1",
    "drupal/redis": "^1",
    "drupal/samlauth": "^3",
    "drupal/search_api": "^1",
    "drupal/search_api_autocomplete": "^1",
    "drupal/search_api_solr": "^4",
    "drupal/simple_sitemap": "^4",
    "drupal/token": "^1",
    "drupal/tour": "^2 || ^3",
    "drupal/twig_field_value": "^2 || ^3",
    "drupal/twig_tweak": "^3",
    "drupal/view_unpublished": "^1",
    "drupal/views_ajax_history": "^1@rc",
    "drupal/views_data_export": "^1",
    "drupal/webform": "^6",
    "fontawesome/fontawesome": "6.7.2",
    "furf/jquery-ui-touch-punch": "dev-master",
    "geocoder-php/common-http": "^4",
    "geocoder-php/nominatim-provider": "^5",
    "markgoodyear/scrollup": "dev-master",
    "neitanod/forceutf8": "^2",
    "noli42/chosen": "3.1.4",
    "owlcarousel2/owlcarousel2": "2.3.4",
    "phpoffice/phpspreadsheet": "^1.5.0",
    "simeydotme/jquery-ui-slider-pips": "^2",
    "turbojettechnologies/colorbox": "dev-master",
    "unb-libraries/alert_scheduler": "dev-11.x-1.x",
    "unb-libraries/calendar_hours": "dev-11.x-1.x",
    "unb-libraries/composer-drupal-scaffold": "^11",
    "unb-libraries/saml_features": "dev-10.x-1.x",
    "unb-libraries/unb_lib_theme": "dev-10.x-4.x",
    "willdurand/geocoder": "^4",
    "zenorocha/clipboardjs": "dev-master"
  },
  "require-dev": {
    "drupal/devel": "^5",
    "unb-libraries/drupal-development-libraries": "^11"
  },
  "type": "project"
}
