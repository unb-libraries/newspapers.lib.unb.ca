<?php

/**
 * @file
 * Contains digital_serial_page.module.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * The shortest time, in seconds, between page saves moving a title's changed time.
 */
const DIGITAL_SERIAL_PAGE_TITLE_CHANGED_INTERVAL = 3600;

/**
 * Implements hook_entity_presave().
 */
function digital_serial_page_entity_presave(EntityInterface $entity) {
  switch ($entity->bundle()) {

    case 'digital_serial_page':
      // The digital titles list shows when each title last had a page added or
      // changed. That takes a full save of the title, and imports save pages by
      // the hundred, so move the time forward at most hourly. SerialPage
      // invalidates the title's cache tag on every save.
      $dst = $entity->getParentIssue()->getParentTitle();
      $now = \Drupal::time()->getRequestTime();
      if ($now - (int) $dst->getChangedTime() >= DIGITAL_SERIAL_PAGE_TITLE_CHANGED_INTERVAL) {
        $dst->setChangedTime($now)->save();
      }

      // Autofill empty page sort field using required page no field.
      $page_no = trim($entity->getPageNo());
      $page_sort = trim($entity->getPageSort());
      if (empty($page_sort)) {
        $entity->setPageSort(str_pad($page_no, 4, "0", STR_PAD_LEFT));
      }

      // Avoid multiple whitespaces.
      $entity->set(
        'page_ocr',
        preg_replace(
          '!\s+!',
          ' ',
          $entity->get('page_ocr')->value
        )
      );
      break;
  }
}

/**
 * Implements hook_help().
 */
function digital_serial_page_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the digital_serial_page module.
    case 'help.page.digital_serial_page':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Digital serial page content') . '</p>';
      return $output;

    default:
  }
}

/**
 * Implements hook_theme().
 */
function digital_serial_page_theme() {
  return [
    'digital_serial_page' => [
      'render element' => 'children',
    ],
  ];
}
