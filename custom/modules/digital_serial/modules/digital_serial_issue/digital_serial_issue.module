<?php

/**
 * @file
 * Contains digital_serial_issue.module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;
use Drupal\views\Views;

/**
 * Implements hook_help().
 */
function digital_serial_issue_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the digital_serial_issue module.
    case 'help.page.digital_serial_issue':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Digital Serial Issue') . '</p>';
      return $output;

    default:
  }
}

/**
 * Implements hook_theme().
 */
function digital_serial_issue_theme() {
  return [
    'digital_serial_issue' => [
      'render element' => 'children',
    ],
  ];
}

/**
 * Implements hook_preprocess_entity().
 */
function digital_serial_issue_preprocess_digital_serial_issue(&$variables) {
  $variables['issue_entity'] = $variables['children']['#digital_serial_issue'];
  $variables['parent_title'] = $variables['issue_entity']->getParentTitle();
  $variables['metadata'] = [];

  $fields_to_parse = [
    'issue_title' => t('Printed Title'),
    'issue_volume' => t('Volume'),
    'issue_issue' => t('Issue'),
    'issue_edition' => t('Edition'),
    'issue_date' => t('Date'),
    'issue_missingp' => t('Missing Pages'),
    'issue_errata' => t('Errata'),
    'langcode' => t('Issue Language'),
    'issue_media' => t('Media'),
  ];

  foreach ($fields_to_parse as $field_name => $field_label) {
    if (!empty($variables['issue_entity']->$field_name->value)) {
      $variables['metadata'][$field_label->render()] = $variables['issue_entity']->$field_name->value;
    }
  }

  // Report additional information or errors button.
  $dst = \Drupal::entityTypeManager()
    ->getStorage('digital_serial_title')
    ->load(
      $variables['parent_title']
        ->id
        ->value
    );
  $full_title =
    $dst
      ->get('parent_title')
      ->entity
      ->getTitle() . ': ' .
    $variables['issue_entity']
      ->get('issue_date')
      ->value;
  $webform_report = \Drupal::entityTypeManager()
    ->getStorage('webform')
    ->load('report_additional_info_errs');
  if ($webform_report != NULL) {
    // Retrieve Webform URL alias for Report webform.
    $report_url = $webform_report->getSetting('page_submit_path');
    if (!empty($report_url)) {
      $variables['display_report_link'] = TRUE;
      $report_url_options = [
        'query' => [
          'newspaper' => $full_title,
          'subdirectory' => 'serials/' .
            $variables['parent_title']->id->value .
            '/issues/' .
            $variables['issue_entity']->id->value,
        ],
      ];
      $variables['report_url'] = Url::fromUri('base:' . $report_url, $report_url_options)->toString();
    }
  }

  $view = Views::getView('digital_page_lister');
  $view->setDisplay('page_carousel');
  $view->setArguments([$variables['issue_entity']->id()]);
  $variables['page_list'] = $view->render();
}

/**
 * Implements hook_views_data_alter().
 *
 * Lets the issue browser render from Solr alone: issue_date gets a date
 * fallback handler, and "First page cover" renders the indexed first-page
 * image URI with the browse_archives image style (issue_cover_image plugin)
 * without loading any entity.
 */
function digital_serial_issue_views_data_alter(array &$data) {
  // Search API maps datetime field items to a plain-text fallback, so turning
  // off entity field rendering on issue_date would print the raw timestamp.
  // Use its date handler instead, which formats the indexed value directly.
  if (isset($data['search_api_index_issues']['issue_date']['field'])) {
    $data['search_api_index_issues']['issue_date']['field']['fallback_handler'] = 'search_api_date';
  }

  if (empty($data['search_api_index_issues']['first_page_image_uri']['field'])) {
    return;
  }
  $field = $data['search_api_index_issues']['first_page_image_uri']['field'];
  $field['id'] = 'issue_cover_image';
  $field['title'] = t('First page cover');
  $data['search_api_index_issues']['first_page_cover'] = [
    'title' => t('First page cover'),
    'help' => t("The issue's first page image, rendered with the browse_archives image style from the indexed URI."),
    'group' => $data['search_api_index_issues']['first_page_image_uri']['group'] ?? t('Search'),
    'field' => $field,
  ];
}
