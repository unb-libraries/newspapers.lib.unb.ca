<?php

use Drupal\Core\File\FileSystemInterface;
use Drupal\node\Entity\Node;

/*
 * Implements hook_install().
 */
function newspapers_core_install() {
  $directories = [
    'serials/publications',
    'serials/publications/supporting-information',
    'serials/publications/thumbnails',
    'serials/families/',
    'serials/families/supporting-information',
    'serials/pages',
  ];
  // Create the file directories and ensure they're writable.
  foreach($directories as $directory) {
    $directory = \Drupal::config('system.file')->get('default_scheme') . "://$directory";
    \Drupal::service('file_system')->prepareDirectory($directory, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS);
  }
}

/**
 * Implements hook_update_N().
 *
 * Process all publication nodes,
 * Migrate plain text from description to description_html field.
 */
function newspapers_core_update_9101(&$sandbox) {
  // Initialize variables during first pass through.
  if (!isset($sandbox['total'])) {
    $nids = \Drupal::entityQuery('node')
      ->accessCheck(TRUE)
      ->condition('type', 'publication')
      ->exists('field_description')
      ->execute();
    // Set sandbox variables.
    $sandbox['total'] = count($nids);
    $sandbox['current'] = 0;
  }
  $batch_size = 25;

  // Process next batch of publication nodes.
  $nids = \Drupal::entityQuery('node')
    ->accessCheck(TRUE)
    ->condition('type', 'publication')
    ->exists('field_description')
    ->range($sandbox['current'], $batch_size)
    ->execute();
  if (empty($nids)) {
    $sandbox['#finished'] = 1;
    return;
  }

  // Operate on this group of publications.
  foreach ($nids as $nid) {
    $publication = Node::load($nid);
    $publication->field_description_html->value = $publication->field_description->value;
    $publication->save();
    $sandbox['current']++;
  }
  unset($nids);

  // Check if we are finished.
  if ($sandbox['current'] >= $sandbox['total']) {
    $sandbox['#finished'] = 1;
  } else {
    $sandbox['#finished'] = ($sandbox['current'] / $sandbox['total']);
  }
}

/**
 * Implements hook_update_N().
 *
 * Swap the removed node_type condition for entity_bundle:node in pathauto
 * patterns. pathauto_update_8108() already ran on this site, but config
 * imports kept restoring node_type; Drupal 10 no longer provides it.
 */
function newspapers_core_update_10001() {
  $config_factory = \Drupal::configFactory();
  foreach ($config_factory->listAll('pathauto.pattern.') as $name) {
    $pattern = $config_factory->getEditable($name);
    $changed = FALSE;
    foreach ($pattern->get('selection_criteria') ?? [] as $uuid => $condition) {
      if ($condition['id'] === 'node_type') {
        $pattern->set("selection_criteria.$uuid.id", 'entity_bundle:node');
        $changed = TRUE;
      }
    }
    if ($changed) {
      $pattern->save(TRUE);
    }
  }
}
